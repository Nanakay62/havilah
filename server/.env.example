# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Security Keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=replace-with-secure-random-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-secure-random-refresh-secret-min-32-chars
SUPER_ADMIN_KEY=replace-with-secure-super-admin-key
HMAC_SECRET=replace-with-secure-hmac-secret

# Email Services (Brevo API)
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Havilah Health

# Fallback SMTP
GMAIL_USER=alerts@yourdomain.com
GMAIL_APP_PASSWORD=your-app-password

# Clinical Partner Defaults
DEFAULT_CLINICAL_PARTNER_NAME=FZ Safety and Health
DEFAULT_CLINICAL_PARTNER_EMAIL=clinical@yourdomain.com
DEFAULT_CLINICAL_HOTLINE=+233 24 362 9870
CLINICAL_INTAKE_EMAIL=intake@yourdomain.com
WHISTLEBLOWER_NOTIFICATION_EMAIL=whistleblower@yourdomain.com
DEFAULT_NOTIFICATION_RECIPIENT=admin@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Platform Configuration
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Redis Cache & Distributed Rate Limiting (Phase 2)
REDIS_URL=redis://localhost:6379

# Paystack Billing (Ghana & Africa - GHS, MoMo, Cards)
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public_key
PAYSTACK_PLAN_STARTER=PLN_starter_monthly
PAYSTACK_PLAN_PRO=PLN_pro_monthly
PAYSTACK_PLAN_ENTERPRISE=PLN_enterprise_monthly
