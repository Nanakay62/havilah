{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://havilah-api.onrender.com/api/v1/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/hr",
      "destination": "/public/hr.html"
    },
    {
      "source": "/superadmin",
      "destination": "/public/superadmin.html"
    },
    {
      "source": "/login",
      "destination": "/public/login.html"
    }
  ]
}
